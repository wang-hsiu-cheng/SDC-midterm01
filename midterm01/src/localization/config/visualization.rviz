Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 50
      Reference Frame: body
      Color: 160; 160; 164
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Map
      Enabled: true
      Topic:
        Value: /visual/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Style: Points
      Size (Pixels): 2
      Alpha: 0.6
      Decay Time: 0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Frame
      Enabled: true
      Topic:
        Value: /visual/frame
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated
      Enabled: true
      Topic:
        Value: /visual/accumulated
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Alpha: 0.8
      Decay Time: 0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Result Path
      Enabled: true
      Topic:
        Value: /visual/path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 0; 255; 0
      Line Style: Lines
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Reference Path
      Enabled: true
      Topic:
        Value: /visual/reference_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 255; 60; 60
      Line Style: Lines
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Pose
      Enabled: true
      Topic:
        Value: /visual/pose
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Axes
      Axes Length: 3
      Axes Radius: 0.3
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: body
      Scale: 8
      Angle: 0
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1600
  Height: 1000
